# Docker Compose interpolation only; not passed wholesale into the container.
PUBLIC_BASE_URL=http://localhost:4173
HTTP_PORT=4173
VPS_VALUE_IMAGE=vps-value:local

# Fresh named volumes use the image's 1000:1000 ownership. Keep these defaults
# unless using an existing bind directory with its own numeric owner/group.
RUN_UID=1000
RUN_GID=1000

# Optional: existing absolute path, used only with compose.bind.yaml.
# SHARES_DIR=/srv/vps-value/storage/shares
